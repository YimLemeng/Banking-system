# ==========================================
# Banking System Environment Configuration
# Copy this file to .env and configure secrets:
# cp .env.example .env
# ==========================================

# Database Credentials
DB_NAME=banking_system_db
DB_USER=banking_system
DB_PASSWORD=your_secure_db_password

# Port Configuration (Defaults to 8081 to avoid conflict with other apps on 8080)
APP_PORT=8081

# Spring Security & JWT
JWT_SECRET=your_256_bit_secure_jwt_secret_base64_encoded
JWT_EXPIRATION=86400000
